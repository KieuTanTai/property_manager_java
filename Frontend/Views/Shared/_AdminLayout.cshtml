<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Admin</title>
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true"/>
</head>
<body class="admin-body">
<div class="admin-shell">
    <aside class="admin-sidebar" aria-label="Admin navigation">
        <div class="admin-brand">
            <span class="admin-brand-mark">DS</span>
            <span>Demo Shop</span>
        </div>
        <nav class="admin-nav">
            <a class="admin-nav-item" href="#" aria-label="Dashboard">
                <span class="admin-nav-icon">⌂</span><span>Dashboard</span>
            </a>
            <a class="admin-nav-item @(ViewData["ActiveAdminPage"] as string == "Accounts" ? "is-active" : null)"
               asp-controller="Admin" asp-action="AccountList"
               aria-current="@(ViewData["ActiveAdminPage"] as string == "Accounts" ? "page" : null)">
                <span class="admin-nav-icon">♙</span><span>Accounts</span>
            </a>
            <a class="admin-nav-item @(ViewData["ActiveAdminPage"] as string == "Finance" ? "is-active" : null)"
               asp-controller="Admin" asp-action="FinanceStats"
               aria-current="@(ViewData["ActiveAdminPage"] as string == "Finance" ? "page" : null)">
                <span class="admin-nav-icon">₫</span><span>Finance</span>
            </a>
            <a class="admin-nav-item @(ViewData["ActiveAdminPage"] as string == "Premises" ? "is-active" : null)"
               asp-controller="Admin" asp-action="PremiseStats"
               aria-current="@(ViewData["ActiveAdminPage"] as string == "Premises" ? "page" : null)">
                <span class="admin-nav-icon">⊡</span><span>Premises</span>
            </a>
            <a class="admin-nav-item @(ViewData["ActiveAdminPage"] as string == "Contracts" ? "is-active" : null)"
               asp-controller="Admin" asp-action="ContractStats"
               aria-current="@(ViewData["ActiveAdminPage"] as string == "Contracts" ? "page" : null)">
                <span class="admin-nav-icon">≡</span><span>Contracts</span>
            </a>
            <a class="admin-nav-item @(ViewData["ActiveAdminPage"] as string == "Violations" ? "is-active" : null)"
               asp-controller="Admin" asp-action="ViolationStats"
               aria-current="@(ViewData["ActiveAdminPage"] as string == "Violations" ? "page" : null)">
                <span class="admin-nav-icon">⚠</span><span>Violations</span>
            </a>
            <a class="admin-nav-item" href="#" aria-label="Roles">
                <span class="admin-nav-icon">◇</span><span>Roles</span>
            </a>
            <a class="admin-nav-item" href="#" aria-label="Permissions">
                <span class="admin-nav-icon">◈</span><span>Permissions</span>
            </a>
            <a class="admin-nav-item" href="#" aria-label="Settings">
                <span class="admin-nav-icon">⚙</span><span>Settings</span>
            </a>
        </nav>
        <div class="admin-sidebar-footer">
            <span class="admin-avatar">AD</span>
            <div><strong>Admin</strong><small>Administrator</small></div>
        </div>
    </aside>
    <main class="admin-main" role="main">
        @RenderBody()
    </main>
</div>
@await RenderSectionAsync("Scripts", false)
</body>
</html>
